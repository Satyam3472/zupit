# Database connection URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zupit

# Seed Owner Admin Configuration
ADMIN_NAME="Jamui Hub Owner"
ADMIN_EMAIL=admin@zupit.in
ADMIN_PHONE=6207856200

# App Server Configuration
PORT=3002
NODE_ENV=development

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=change_me_in_production_jwt_secret_32chars
DELIVERY_CODE_SECRET=change_me_in_production_delivery_secret_32chars

# SMS Gateway Configuration
# Options: 'mock' (local dev / testing) | 'msg91' (production)
SMS_PROVIDER=mock
ALLOW_MOCK_SMS=false

# Optional MSG91 Credentials (required if SMS_PROVIDER=msg91)
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SENDER_ID=ZUPITM
