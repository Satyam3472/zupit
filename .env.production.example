# ==============================================================================
# Zupit Production Environment Configuration (.env.production)
# Mode A: Direct IP testing at http://82.29.165.59:3100
# Mode B: Domain with HTTPS at https://yourdomain.in
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base URL & Cookie Security
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public-facing origin of Zupit (Mode A uses IP:3100; Mode B uses https://yourdomain.in)
PUBLIC_URL=http://82.29.165.59:3100

# Set COOKIE_SECURE=false for HTTP testing (Mode A).
# Set COOKIE_SECURE=true when running over HTTPS (Mode B).
COOKIE_SECURE=false

# Port on the VPS host where Caddy edge proxy listens (3100 ensures no conflict with :3000)
EDGE_PORT=3100

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Database Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=zupit_admin
# Generated with: openssl rand -hex 24 (or via scripts/gen-secrets.sh)
POSTGRES_PASSWORD=generate_strong_postgres_password_here
POSTGRES_DB=zupit_prod

# Fully qualified connection URL used by the app and migration runner
DATABASE_URL=postgres://zupit_admin:${POSTGRES_PASSWORD}@db:5432/zupit_prod

# ------------------------------------------------------------------------------
# 3. Security Secrets (Production Guard: MUST be >= 32 characters, no example values)
# ------------------------------------------------------------------------------
# Secret for signing administrative & rider JWT authentication tokens
JWT_SECRET=generate_random_32_plus_char_secret_with_openssl_rand_hex_32

# Secret for customer order delivery verification codes
DELIVERY_CODE_SECRET=generate_random_32_plus_char_secret_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 4. S3-Compatible Object Storage (MinIO)
# ------------------------------------------------------------------------------
# Internal endpoint for server-to-MinIO communication
S3_ENDPOINT=http://minio:9000

# Public-facing endpoint for browser presigned uploads and downloads
# In Mode A, routes through the single entry point (http://82.29.165.59:3100/zupit-private/...)
S3_PUBLIC_ENDPOINT=http://82.29.165.59:3100

# MinIO root credentials
MINIO_ROOT_USER=zupit_minio_admin
MINIO_ROOT_PASSWORD=generate_strong_minio_password_here

# S3 access keys used by backend application to create presigned URLs
S3_ACCESS_KEY=zupit_minio_admin
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET=zupit-private

# ------------------------------------------------------------------------------
# 5. SMS Gateway Configuration
# ------------------------------------------------------------------------------
# Options: 'mock' (logs OTPs to container stdout) | 'msg91' (production gateway)
SMS_PROVIDER=mock

# Temporary pilot fallback flag. Refuses to boot with SMS_PROVIDER=mock unless true.
ALLOW_MOCK_SMS=true

# MSG91 Credentials (Required when SMS_PROVIDER=msg91)
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_SENDER_ID=ZUPITM

# ------------------------------------------------------------------------------
# 6. Initial Seed Admin Account (Used by seed-prod.sh on first run only)
# ------------------------------------------------------------------------------
ADMIN_NAME="Jamui Hub Owner"
ADMIN_EMAIL=admin@zupit.in
ADMIN_PHONE=6207856200
# Set strong temporary password; seed-prod.sh will seed the user and clear this variable
ADMIN_PASSWORD=InitialAdminPassword2026!

# ------------------------------------------------------------------------------
# 7. Optional Off-Site Database Backup Sync (rclone to S3 / Wasabi / R2)
# ------------------------------------------------------------------------------
# BACKUP_REMOTE_BUCKET=my-zupit-offsite-backups
# BACKUP_REMOTE_TYPE=s3
# BACKUP_REMOTE_PROVIDER=AWS
# BACKUP_REMOTE_ACCESS_KEY=
# BACKUP_REMOTE_SECRET_KEY=
# BACKUP_REMOTE_ENDPOINT=
# BACKUP_REMOTE_REGION=ap-south-1
